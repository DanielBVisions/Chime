---
// Rebuilt from the live site's "Driving Productivity" diagram (a hub +
// three feature columns) — the content doc's "two infographic images"
// don't exist on the live site as separate assets; this is the actual
// content, built as real markup instead of an image.
const columns = [
  {
    title: 'Field Operations',
    subtitle: 'Enhancing In-Field Work Execution',
    icon: '<path d="M12 19 V5 M12 5 L7 10 M12 5 L17 10"/>',
    points: [
      'Simplifies mobile work processes, providing workers with essential data.',
      'Enables higher output per job, reducing delays and maximising efficiency.',
      'Live updates and workforce tracking allow rapid response and task reassignment.',
    ],
  },
  {
    title: 'Invest',
    subtitle: 'Accelerating Investment Plan Execution',
    icon: '<path d="M4 15 A8 8 0 0 1 20 15"/><path d="M12 15 L16 10"/><circle cx="12" cy="15" r="1.2" fill="currentColor" stroke="none"/>',
    points: [
      'Turns investment plans into actionable jobs with cost & performance tracking.',
      'Reduces engineering workload while enabling better contractor cost management.',
      'Simplifies financial and regulatory processes, integrating seamlessly with SAP and Oracle.',
    ],
  },
  {
    title: 'Asset Management',
    subtitle: 'Enhancing Infrastructure Control',
    icon: '<path d="M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z"/>',
    points: [
      'Provides real-time asset tracking for improved maintenance efficiency.',
      'Ensures regulatory compliance with automated processes.',
      'Enables paperless operations, reducing errors and enhancing decision-making.',
    ],
  },
];
---

<section class="section delivers">
  <div class="container">
    <div data-reveal>
      <h2 data-reveal-heading>What CHIME Delivers</h2>
      <h3 class="delivers__sub">Improving Volume Output</h3>
      <p>
        Work force productivity holds the key to improving regulated volumes output. CHIME focuses
        on both engineering and in-field productivity to deliver higher volumes. CHIME goes beyond
        scheduling and work management to enable faster work execution, maximising volumes per site
        visit and reducing the engineering time needed to manage.
      </p>
      <p>
        No other application has been designed to specifically target work productivity. CHIME
        stands apart as the only application built with Network Operators for Network Operators
      </p>

      <h3 class="delivers__functionality-heading">
        CHIME Equips You with All This Essential Functionality to Drive Productivity and Efficiency.
      </h3>
    </div>

    <div class="delivers__diagram" data-reveal>
      <div class="delivers__hub">
        <span class="delivers__hub-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
            <path d="M9 12 V6.5 a1.5 1.5 0 0 1 3 0 V12" />
            <path d="M12 12 V5.5 a1.5 1.5 0 0 1 3 0 V12" />
            <path d="M15 12 V7.5 a1.5 1.5 0 0 1 3 0 V13 c0 3.8 -2.2 6.5 -6.5 6.5 S3 16.8 3 13 V11 a1.5 1.5 0 0 1 3 0" />
          </svg>
        </span>
        <h4>Driving Productivity</h4>
        <p>
          CHIME equips network operators with three core elements that streamline work delivery,
          investment planning, and asset management, to increase productivity and improve
          efficiency.
        </p>
      </div>

      <div class="delivers__columns">
        {columns.map((column) => (
          <div class="delivers__column">
            <div class="delivers__column-header">
              <span class="delivers__column-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" set:html={column.icon} />
              </span>
              <h5>{column.title}</h5>
              <p>{column.subtitle}</p>
            </div>

            <ul>
              {column.points.map((point) => (
                <li>
                  <svg class="delivers__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 12 L10 18 L20 6" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .delivers h2 {
    font-size: 2.125rem;
    font-weight: 800;
  }

  .delivers__sub {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-blue-deep);
  }

  .delivers p {
    margin-top: 1rem;
    max-width: 56rem;
    line-height: 1.7;
    color: var(--color-grey-600);
  }

  .delivers__functionality-heading {
    margin-top: var(--space-gutter);
    font-size: 1.5rem;
    font-weight: 700;
    max-width: 44rem;
    color: var(--color-ink);
  }

  .delivers__diagram {
    margin-top: var(--space-section);
  }

  .delivers__hub {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
    padding: 2.5rem 2rem 2rem;
    text-align: center;
    background: var(--color-grey-100);
    border-radius: 20px;
  }

  .delivers__hub-icon,
  .delivers__column-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--gradient-signal);
  }

  .delivers__hub-icon {
    position: absolute;
    top: -1.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 3.5rem;
    height: 3.5rem;
  }

  .delivers__hub-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .delivers__hub h4 {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-blue-deep);
  }

  .delivers__hub p {
    margin-top: 0.75rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  .delivers__columns {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .delivers__columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .delivers__column {
    background: var(--color-white);
    border: 1px solid var(--color-grey-100);
    border-radius: 18px;
    padding: 1.75rem;
    box-shadow: 0 8px 20px -6px rgba(20, 24, 29, 0.08);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .delivers__column:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 32px -12px rgba(11, 92, 173, 0.2);
  }

  .delivers__column-header {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-grey-100);
  }

  .delivers__column-icon {
    width: 2.75rem;
    height: 2.75rem;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .delivers__column:hover .delivers__column-icon {
    transform: scale(1.15) rotate(-8deg);
  }

  .delivers__column-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .delivers__column-header h5 {
    margin-top: 1rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .delivers__column-header p {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-grey-600);
    max-width: none;
  }

  .delivers__column ul {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .delivers__column li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .delivers__check {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    color: var(--color-blue-deep);
  }

  .delivers__column li span {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-grey-600);
  }

  @media (prefers-reduced-motion: reduce) {
    .delivers__column,
    .delivers__column-icon {
      transition: none;
    }
  }
</style>
