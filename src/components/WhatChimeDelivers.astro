---
// Rebuilt from the live site's "Driving Productivity" diagram (a hub +
// three feature columns) — the content doc's "two infographic images"
// don't exist on the live site as separate assets; this is the actual
// content, built as real markup instead of an image.
const columns = [
  {
    title: 'Field Operations',
    subtitle: 'Enhancing In-Field Work Execution',
    icon: '<path d="M12 19 V5 M12 5 L7 10 M12 5 L17 10"/>',
    points: [
      'Simplifies mobile work processes, providing workers with essential data.',
      'Enables higher output per job, reducing delays and maximising efficiency.',
      'Live updates and workforce tracking allow rapid response and task reassignment.',
    ],
  },
  {
    title: 'Invest',
    subtitle: 'Accelerating Investment Plan Execution',
    icon: '<path d="M4 15 A8 8 0 0 1 20 15"/><path d="M12 15 L16 10"/><circle cx="12" cy="15" r="1.2" fill="currentColor" stroke="none"/>',
    points: [
      'Turns investment plans into actionable jobs with cost & performance tracking.',
      'Reduces engineering workload while enabling better contractor cost management.',
      'Simplifies financial and regulatory processes, integrating seamlessly with SAP and Oracle.',
    ],
  },
  {
    title: 'Asset Management',
    subtitle: 'Enhancing Infrastructure Control',
    icon: '<path d="M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z"/>',
    points: [
      'Provides real-time asset tracking for improved maintenance efficiency.',
      'Ensures regulatory compliance with automated processes.',
      'Enables paperless operations, reducing errors and enhancing decision-making.',
    ],
  },
];
---

<section class="section delivers">
  <div class="container">
    <div data-reveal>
      <h2 data-reveal-heading>What CHIME Delivers</h2>
      <h3 class="delivers__sub">Improving Volume Output</h3>
      <p>
        Work force productivity holds the key to improving regulated volumes output. CHIME focuses
        on both engineering and in-field productivity to deliver higher volumes. CHIME goes beyond
        scheduling and work management to enable faster work execution, maximising volumes per site
        visit and reducing the engineering time needed to manage.
      </p>
      <p>
        No other application has been designed to specifically target work productivity. CHIME
        stands apart as the only application built with Network Operators for Network Operators
      </p>

      <h3 class="delivers__functionality-heading">
        CHIME Equips You with All This Essential Functionality to Drive Productivity and Efficiency.
      </h3>
    </div>

    <div class="delivers__diagram" data-reveal>
      <div class="delivers__hub">
        <span class="delivers__hub-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6">
            <path d="M9 12 V6.5 a1.5 1.5 0 0 1 3 0 V12" />
            <path d="M12 12 V5.5 a1.5 1.5 0 0 1 3 0 V12" />
            <path d="M15 12 V7.5 a1.5 1.5 0 0 1 3 0 V13 c0 3.8 -2.2 6.5 -6.5 6.5 S3 16.8 3 13 V11 a1.5 1.5 0 0 1 3 0" />
          </svg>
        </span>
        <h4>Driving Productivity</h4>
        <p>
          CHIME equips network operators with three core elements that streamline work delivery,
          investment planning, and asset management, to increase productivity and improve
          efficiency.
        </p>
      </div>

      <div class="delivers__timeline-track" data-delivers-track>
        <div class="delivers__timeline" data-delivers-timeline>
          <div class="delivers__rail" aria-hidden="true">
            <span class="delivers__rail-marker" data-delivers-marker></span>
          </div>

          <div class="delivers__steps">
            {columns.map((column, index) => (
              <div class="delivers__step" data-delivers-step>
                <button
                  type="button"
                  class="delivers__step-header"
                  data-delivers-step-header
                  aria-expanded={index === 0 ? 'true' : 'false'}
                >
                  <span class="delivers__step-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="delivers__step-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" set:html={column.icon} />
                  </span>
                  <span class="delivers__step-title">
                    <strong>{column.title}</strong>
                    <span>{column.subtitle}</span>
                  </span>
                </button>

                <div class="delivers__step-body" data-delivers-step-body>
                  <ul>
                    {column.points.map((point) => (
                      <li>
                        <svg class="delivers__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M4 12 L10 18 L20 6" />
                        </svg>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .delivers h2 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .delivers__sub {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-blue-deep);
  }

  .delivers p {
    margin-top: 1rem;
    max-width: 56rem;
    line-height: 1.7;
    color: var(--color-grey-600);
  }

  .delivers__functionality-heading {
    margin-top: var(--space-gutter);
    font-size: 1.5rem;
    font-weight: 700;
    max-width: 44rem;
    color: var(--color-ink);
  }

  .delivers__diagram {
    margin-top: var(--space-section);
  }

  .delivers__hub {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
    padding: 2.5rem 2rem 2rem;
    text-align: center;
    background: var(--color-grey-100);
    border-radius: 20px;
  }

  .delivers__hub-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--gradient-signal);
    position: absolute;
    top: -1.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 3.5rem;
    height: 3.5rem;
  }

  .delivers__hub-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .delivers__hub h4 {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-blue-deep);
  }

  .delivers__hub p {
    margin-top: 0.75rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  /* Sui-style scroll-driven accordion: a dotted rail with a marker that
     travels down it, opening one step at a time as you scroll through the
     track below. Built on native position: sticky rather than a GSAP
     pin — sticky stays constrained to its own parent's box using the
     browser's own layout engine, so it can't end up detached in the
     viewport corner or left stranded on top of later content the way a
     JS-driven position: fixed pin can if anything about its surrounding
     layout doesn't match what the pin math assumed. delivers-timeline.ts
     only sets the track's scroll height and drives the marker/active
     step — the "stays in place while you scroll" part is plain CSS.

     Layout: the rail runs down the centre, and steps are cards that
     alternate left/right of it (odd = right, even = left) with generous
     gaps between them — not a flex row with the rail on one side and a
     full-width column on the other, which is what made every card look
     like it was hugging the left edge regardless of any width/centring
     rule, since the *steps column itself* was always the one stretching
     full-width, not any individual card. */
  .delivers__timeline-track {
    position: relative;
  }

  .delivers__timeline {
    position: relative;
    margin-top: var(--space-section);
  }

  @media (min-width: 900px) {
    .delivers__timeline.is-stepped {
      position: sticky;
      top: 88px;
    }
  }

  .delivers__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    display: none;
  }

  .delivers__timeline.is-stepped .delivers__rail {
    display: block;
  }

  .delivers__rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-left: 2px dotted var(--color-grey-400);
    transform: translateX(-50%);
  }

  .delivers__rail-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--color-blue-deep);
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 4px rgba(11, 92, 173, 0.15);
  }

  .delivers__steps {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .delivers__step {
    background: var(--color-white);
    border-radius: 20px;
    box-shadow: 0 24px 48px -24px rgba(20, 24, 29, 0.22);
    padding: 1.75rem 2rem;
  }

  @media (min-width: 900px) {
    .delivers__step {
      width: calc(50% - 2.5rem);
    }

    /* 01 and 03 sit right of the rail, 02 sits left — the staggered
       zig-zag look, rather than every card stacked in one column. */
    .delivers__step:nth-child(odd) {
      margin-left: auto;
    }

    .delivers__step:nth-child(even) {
      margin-right: auto;
    }
  }

  .delivers__step-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .delivers__step-number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-grey-400);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-grey-600);
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .delivers__step.is-active .delivers__step-number {
    background: var(--color-blue-deep);
    border-color: var(--color-blue-deep);
    color: var(--color-white);
  }

  .delivers__step-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--gradient-signal);
  }

  .delivers__step-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .delivers__step-title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .delivers__step-title strong {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .delivers__step-title span {
    font-size: 0.8125rem;
    color: var(--color-grey-600);
  }

  .delivers__step-body {
    overflow: hidden;
    /* Height only changes at discrete step-change moments (not every
       scroll frame — that's the marker), so easing it here doesn't fight
       anything the way it would have under the old GSAP pin, which
       needed the pinned box's total height to stay pixel-identical for
       its whole duration. position: sticky has no such constraint. */
    transition: height 0.4s ease, opacity 0.3s ease;
  }

  .delivers__timeline.is-stepped .delivers__step-body {
    height: 0;
    opacity: 0;
  }

  .delivers__timeline.is-stepped .delivers__step.is-active .delivers__step-body {
    opacity: 1;
  }

  .delivers__step-body ul {
    padding-bottom: 2rem;
    padding-left: 3.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .delivers__step-body li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .delivers__check {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    color: var(--color-blue-deep);
  }

  .delivers__step-body li span {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-grey-600);
  }

  @media (prefers-reduced-motion: reduce) {
    .delivers__step-number {
      transition: none;
    }

    .delivers__step-body {
      transition: none;
    }
  }
</style>
