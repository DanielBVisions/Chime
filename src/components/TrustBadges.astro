---
// Rendered as text wordmarks for now — swap each span for a real badge <img>
// once assets are sourced (tech spec §8).
const badges = [
  'NQA ISO 9001 (UKAS)',
  'NQA ISO 27001 (UKAS)',
  'Microsoft',
  'SAP',
  'Cyber Essentials',
  'Tech Awards Winner 2025',
];
---

<section class="trust-badges">
  <div class="container">
    <ul class="trust-badges__list" data-reveal>
      {badges.map((badge) => (
        <li>{badge}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-badges {
    border-bottom: 1px solid var(--color-grey-100);
  }

  .trust-badges__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 3.5rem;
    padding-block: 3rem;
  }

  .trust-badges__list li {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-grey-600);
  }
</style>
