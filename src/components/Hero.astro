---
import BrandArc from './BrandArc.astro';
---

<section class="hero" data-hero>
  <BrandArc size={640} anchor="top-right" style="top: -140px; right: -140px;" />
  <div class="hero__glow" data-hero-glow aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow" data-hero-line>Software for network operators</span>
      <h1 class="hero__wordmark" data-hero-line>CHiME<sup>&reg;</sup></h1>
      <p class="hero__subhead" data-hero-line>Built for the network operator.</p>
      <p class="hero__body" data-hero-line>
        The industry-first application designed to improve field force productivity while
        addressing the industry-wide challenge of increasing regulatory volumes.
      </p>
      <div class="hero__actions" data-hero-line>
        <a href="/contact" class="btn btn--lg">Enquire Now For a Demo</a>
        <a href="/chime" class="hero__link">Discover the CHiME advantage &rarr;</a>
      </div>
    </div>

    <div class="hero__media">
      <img class="hero__poster" src="/video/hero-poster.jpg" alt="" fetchpriority="high" />
      <video
        class="hero__video"
        data-hero-video
        src="/video/hero.mp4"
        poster="/video/hero-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
      </video>
    </div>
  </div>

  <div class="container hero__trust" data-hero-line>
    <span class="hero__trust-label">Trusted by</span>

    <div class="hero__trust-marquee" data-hero-trust>
      <div class="hero__trust-group" data-hero-trust-group>
        <ul class="hero__trust-list" data-hero-trust-track>
          <li>UK Power Networks</li>
          <li>SSE</li>
          <li>Cadent Gas</li>
          <li>ESB Networks</li>
          <li>SP Electricity North West</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    min-height: 95svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 4rem 3.5rem;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(500px circle at var(--x, 50%) var(--y, 50%), rgba(63, 169, 218, 0.22), transparent 65%);
  }

  .hero__glow.is-active {
    opacity: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 3.5rem;
  }

  .hero__copy {
    flex: 1 1 35rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero__eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-blue-deep);
  }

  .hero__wordmark {
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-blue-deep);
  }

  .hero__wordmark sup {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-grey-600);
  }

  .hero__subhead {
    font-size: 1.625rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 26ch;
  }

  .hero__body {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-grey-600);
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    margin-top: 0.5rem;
  }

  .hero__link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .hero__media {
    position: relative;
    flex: 1 1 30rem;
    aspect-ratio: 4 / 3;
    border-radius: 1.75rem;
    overflow: hidden;
    box-shadow: 0 30px 70px -20px rgba(11, 92, 173, 0.35);
    background: linear-gradient(135deg, var(--color-blue-pale), var(--color-blue-mid) 55%, var(--color-blue-deep));
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
  }

  /* Data-saver mode: skip the video entirely, poster stands in as the hero image. */
  @media (prefers-reduced-data: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__trust {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }

  .hero__trust-label {
    flex-shrink: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-600);
  }

  /* Looping marquee — same clone-and-scroll mechanism as the partner
     logos strip further down the page (role-ticker.ts), just with its
     own selectors/speed. Wrapped, non-looping list is the base/reduced-
     motion state; is-marquee is added once JS clones the track. */
  .hero__trust-marquee {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .hero__trust-group {
    display: flex;
  }

  .hero__trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    width: 100%;
  }

  .hero__trust-list li {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-grey-600);
    white-space: nowrap;
  }

  .hero__trust-marquee.is-marquee .hero__trust-group {
    width: max-content;
  }

  .hero__trust-marquee.is-marquee .hero__trust-list {
    flex-wrap: nowrap;
    width: max-content;
    padding-inline-end: 3rem;
  }

  @media (max-width: 900px) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__trust {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }

  [data-hero-line] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-line] {
      opacity: 1;
    }
  }
</style>
