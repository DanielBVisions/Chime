---
---

<section class="hero" data-hero>
  <img class="hero__poster" src="/video/hero-poster.jpg" alt="" fetchpriority="high" />

  <video
    class="hero__video"
    data-hero-video
    src="/video/hero.mp4"
    poster="/video/hero-poster.jpg"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
  >
  </video>

  <div class="hero__content container">
    <p class="hero__eyebrow" data-hero-line>CHiME</p>
    <h1 class="hero__headline" data-hero-line>Built for the Network Operator</h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__video {
    opacity: 0;
  }

  /* Data-saver mode: skip the video entirely, poster stands in as the hero image. */
  @media (prefers-reduced-data: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.35), rgba(10, 10, 10, 0.6));
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    color: var(--color-white);
  }

  .hero__eyebrow {
    font-size: var(--fs-hero);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero__headline {
    margin-top: 1rem;
    font-size: var(--fs-h1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    max-width: 20ch;
  }

  [data-hero-line] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-line] {
      opacity: 1;
    }
  }
</style>
