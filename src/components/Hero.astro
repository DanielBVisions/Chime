---
import BrandArc from './BrandArc.astro';
---

<section class="hero" data-hero>
  <BrandArc size={640} anchor="top-right" style="top: -140px; right: -140px;" />
  <div class="hero__glow" data-hero-glow aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__eyebrow" data-hero-line>CHiME<sup>&reg;</sup></span>
      <h1 class="hero__headline" data-hero-line>
        Built for<br />
        <span class="hero__headline-accent">the network operator</span>
      </h1>
      <div class="hero__actions" data-hero-line>
        <a href="/contact" class="btn btn--lg">Enquire Now For a Demo</a>
        <a href="/chime" class="hero__link">Discover the CHiME advantage &rarr;</a>
      </div>
    </div>

    <div class="hero__media">
      <img class="hero__poster" src="/video/hero-poster.jpg" alt="" fetchpriority="high" />
      <video
        class="hero__video"
        data-hero-video
        src="/video/hero.mp4"
        poster="/video/hero-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
      </video>
    </div>
  </div>

  <div class="container hero__trust" data-hero-line>
    <span class="hero__trust-label">Trusted by</span>

    <div class="hero__trust-marquee" data-hero-trust>
      <div class="hero__trust-group" data-hero-trust-group>
        <ul class="hero__trust-list" data-hero-trust-track>
          <li>UK Power Networks</li>
          <li>SSE</li>
          <li>Cadent Gas</li>
          <li>ESB Networks</li>
          <li>SP Electricity North West</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    min-height: 95svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 4rem 0;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(500px circle at var(--x, 50%) var(--y, 50%), rgba(63, 169, 218, 0.22), transparent 65%);
  }

  .hero__glow.is-active {
    opacity: 1;
  }

  /* Centred and stacked: copy on top, media below — contained within the
     container's normal padding rather than bleeding to the viewport
     edge. Was a two-column side-by-side grid; that's gone entirely, not
     just re-tuned. */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 9rem;
  }

  .hero__copy {
    max-width: 64rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* CHiME is now the small label above the real headline, not the
     dominant text — a plain small-caps mark, not a big wordmark. */
  .hero__eyebrow {
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue-deep);
  }

  .hero__eyebrow sup {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-grey-600);
  }

  .hero__headline {
    /* Fixed rem, no local clamp/vw: the Osmo root scaling (tokens.css)
       already makes the root font-size fluid, so a local clamp() here
       would compound with it. Since both this and .hero__copy's
       max-width are in rem, the fit is a ratio, not a pixel target —
       4.5rem keeps "the network operator" on one line at 64rem. */
    font-size: 4.5rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .hero__headline-accent {
    color: var(--color-blue-mid);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.125rem;
    margin-top: 0.5rem;
  }

  .hero__link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  /* Wide band below the copy, not a side column any more — 4:3 was sized
     for sitting next to the text; full-width at that ratio would now be
     absurdly tall. width: 100% of .hero__inner (which already carries
     the container's own padding) keeps it contained within the normal
     margins rather than bleeding to the viewport edge — no additional
     max-width here, it should fill that full width, not sit narrower
     than the container within it. */
  .hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 2.8 / 1;
    border-radius: 1.75rem;
    overflow: hidden;
    box-shadow: 0 30px 70px -20px rgba(11, 92, 173, 0.35);
    background: linear-gradient(135deg, var(--color-blue-pale), var(--color-blue-mid) 55%, var(--color-blue-deep));
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
  }

  /* Data-saver mode: skip the video entirely, poster stands in as the hero image. */
  @media (prefers-reduced-data: reduce) {
    .hero__video {
      display: none;
    }
  }

  .hero__trust {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 5rem;
    opacity: 0.7;
  }

  .hero__trust-label {
    flex-shrink: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-600);
  }

  /* Looping marquee — same clone-and-scroll mechanism as the partner
     logos strip further down the page (role-ticker.ts), just with its
     own selectors/speed. Wrapped, non-looping list is the base/reduced-
     motion state; is-marquee is added once JS clones the track. */
  .hero__trust-marquee {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .hero__trust-group {
    display: flex;
  }

  .hero__trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    width: 100%;
  }

  .hero__trust-list li {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-grey-600);
    white-space: nowrap;
  }

  .hero__trust-marquee.is-marquee .hero__trust-group {
    width: max-content;
  }

  .hero__trust-marquee.is-marquee .hero__trust-list {
    flex-wrap: nowrap;
    width: max-content;
    padding-inline-end: 3rem;
  }

  @media (max-width: 900px) {
    .hero__trust {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }

  [data-hero-line] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-line] {
      opacity: 1;
    }
  }
</style>
