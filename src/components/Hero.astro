---
---

<section class="hero">
  <video
    class="hero__video"
    src="/video/hero.mp4"
    poster="/video/hero-poster.jpg"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
  >
  </video>

  <div class="hero__content container">
    <p class="hero__eyebrow">CHiME</p>
    <h1 class="hero__headline">Built for the Network Operator</h1>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-ink);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.35), rgba(10, 10, 10, 0.6));
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    color: var(--color-white);
  }

  .hero__eyebrow {
    font-size: var(--fs-hero);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero__headline {
    margin-top: 1rem;
    font-size: var(--fs-h1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    max-width: 20ch;
  }
</style>
