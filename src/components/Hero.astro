---
import BrandArc from './BrandArc.astro';
---

<section class="hero" data-hero>
  <BrandArc size={640} anchor="top-right" style="top: -140px; right: -140px;" />

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow" data-hero-line>CHiME</p>
      <h1 class="hero__headline" data-hero-line>Built for the Network Operator</h1>
    </div>

    <div class="hero__media">
      <img class="hero__poster" src="/video/hero-poster.jpg" alt="" fetchpriority="high" />
      <video
        class="hero__video"
        data-hero-video
        src="/video/hero.mp4"
        poster="/video/hero-poster.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
      </video>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    padding-block: clamp(6rem, 12vw, 9rem) clamp(3rem, 6vw, 5rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero__copy {
    flex: 1 1 28rem;
  }

  .hero__eyebrow {
    font-size: var(--fs-hero);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-ink);
  }

  .hero__headline {
    margin-top: 1rem;
    font-size: var(--fs-h1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    max-width: 20ch;
    color: var(--color-ink);
  }

  .hero__media {
    position: relative;
    flex: 1 1 26rem;
    aspect-ratio: 4 / 3;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 70px -20px rgba(11, 92, 173, 0.35);
    background: linear-gradient(135deg, var(--color-blue-pale), var(--color-blue-mid) 55%, var(--color-blue-deep));
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
  }

  /* Data-saver mode: skip the video entirely, poster stands in as the hero image. */
  @media (prefers-reduced-data: reduce) {
    .hero__video {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      flex-direction: column;
      align-items: stretch;
    }
  }

  [data-hero-line] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-line] {
      opacity: 1;
    }
  }
</style>
