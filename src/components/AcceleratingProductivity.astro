---
import BrandArc from './BrandArc.astro';
---

<section class="accelerating">
  <BrandArc
    size={640}
    anchor="top-right"
    style="top: auto; bottom: -12rem; right: -12rem; transform: scaleY(-1);"
  />

  <div class="container accelerating__inner" data-reveal>
    <h2 class="accelerating__heading">Accelerating Productivity</h2>
    <p class="accelerating__body">
      CHIME is the 'industry first' application for network operators, designed to improve field
      force productivity while addressing the industry-wide challenge of increasing regulatory
      volumes. With over 25 years of experience and a dedicated focus on network operators since
      2014, we understand the industry challenges, and ensure every aspect of CHiME is designed to
      meet these unique challenges.
    </p>
  </div>
</section>

<style>
  .accelerating {
    position: relative;
    overflow: hidden;
    margin-inline: 1.25rem;
    border-radius: 2rem;
    background: linear-gradient(120deg, var(--color-blue-deep), var(--color-blue-mid) 130%);
    color: var(--color-white);
  }

  @media (min-width: 768px) {
    .accelerating {
      margin-inline: 2rem;
    }
  }

  @media (min-width: 1200px) {
    .accelerating {
      margin-inline: 5rem;
      border-radius: 2.5rem;
    }
  }

  /* Same scrim recipe as EnquireCta's gradient band: the lighter end alone
     only gives white text ~2.7:1 contrast, under the 4.5:1 AA minimum. */
  .accelerating::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(0, 0, 0, 0.35);
  }

  .accelerating__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 3rem 1.25rem;
    max-width: 48rem;
  }

  @media (min-width: 768px) {
    .accelerating__inner {
      padding: 4rem 2rem;
    }
  }

  @media (min-width: 1200px) {
    .accelerating__inner {
      padding: 5rem;
    }
  }

  .accelerating__heading {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-blue-pale);
  }

  .accelerating__body {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
