---
---

<section class="accelerating">
  <div class="accelerating__inner" data-reveal>
    <div class="accelerating__copy">
      <h2 class="accelerating__heading">Accelerating Productivity</h2>

      <p class="accelerating__body">
        CHIME is the 'industry first' application for network operators, designed to improve field
        force productivity while addressing the industry-wide challenge of increasing regulatory
        volumes. With over 25 years of experience and a dedicated focus on network operators since
        2014, we understand the industry challenges, and ensure every aspect of CHiME is designed to
        meet these unique challenges.
      </p>
    </div>

    <div class="accelerating__media">
      <picture>
        <source srcset="/images/accelerating-network.avif" type="image/avif" />
        <img src="/images/accelerating-network.jpg" alt="" loading="lazy" decoding="async" />
      </picture>
    </div>
  </div>
</section>

<style>
  .accelerating {
    position: relative;
    overflow: hidden;
    margin-inline: 1.25rem;
    border-radius: 2rem;
    background: linear-gradient(120deg, var(--color-blue-deep), var(--color-blue-mid) 130%);
    color: var(--color-white);
  }

  @media (min-width: 768px) {
    .accelerating {
      margin-inline: 2rem;
    }
  }

  @media (min-width: 1200px) {
    .accelerating {
      margin-inline: 5rem;
      border-radius: 2.5rem;
    }
  }


  /* Two columns, both stretched to the same height: copy (heading pinned to
     the top, paragraph pinned to the bottom, via space-between) alongside
     an image column running the FULL height of the card - not a small
     icon tucked in a corner with dead space around it. */
  .accelerating__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 3rem;
    min-height: 75svh;
    padding: 2em;
  }

  .accelerating__copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .accelerating__heading {
    font-size: clamp(2em, 4vw, 3em);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .accelerating__body {
    max-width: 32rem;
    font-size: 1.125em;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
  }

  .accelerating__media {
    border-radius: 1.5rem;
    overflow: hidden;
  }

  .accelerating__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .accelerating__inner {
      grid-template-columns: 1fr;
    }

    .accelerating__media {
      order: -1;
      aspect-ratio: 4 / 3;
    }
  }
</style>
