---
import BrandArc from './BrandArc.astro';
---

<section class="accelerating">
  <BrandArc
    size={640}
    anchor="top-right"
    style="top: auto; bottom: -12rem; right: -12rem; transform: scaleY(-1);"
  />

  <div class="container accelerating__inner" data-reveal>
    <h2 class="accelerating__heading">Accelerating Productivity</h2>
    <p class="accelerating__body">
      CHiME is the 'industry first' application for network operators, designed to improve field
      force productivity while addressing the industry-wide challenge of increasing regulatory
      volumes. With over 25 years of experience and a dedicated focus on network operators since
      2014, we understand the industry challenges, and ensure every aspect of CHiME is designed to
      meet these unique challenges.
    </p>
  </div>
</section>

<style>
  .accelerating {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    padding-block: 7rem;
  }

  .accelerating__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
    max-width: 56rem;
  }

  /* Amber accent matched from the reference screenshot of the live site —
     not yet in tokens.css since nothing else on the page uses it. */
  .accelerating__heading {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #E8A33D;
  }

  .accelerating__body {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
</style>
