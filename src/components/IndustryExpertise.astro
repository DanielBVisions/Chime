---
---

<section class="industry">
  <div class="container industry__split">
    <div class="industry__media" data-reveal data-parallax-wrap>
      <img
        src="/images/industry-professionals-bg.jpg"
        alt=""
        loading="lazy"
        decoding="async"
        data-parallax-image
      />
    </div>

    <div class="industry__text" data-reveal>
      <span class="eyebrow">Industry Expertise</span>
      <p class="industry__intro">
        We understand the challenges faced by network operators and the expertise required to
        drive operational success. That's why CHIME was developed with insights from professionals
        across the industry, ensuring it meets the real-world needs of those working on the front
        lines.
      </p>
    </div>
  </div>
</section>

<style>
  .industry {
    background: var(--color-white);
  }

  .industry__split {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding-block: 7rem;
  }

  .industry__media {
    position: relative;
    flex: 0 0 28.75rem;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-grey-100), #dce9f2 55%, #c9e4f0);
  }

  /* Sized 116% with a matching negative inset so the scroll-parallax drift
     (--parallax-y, from image-parallax.ts) and the hover-zoom (--hover-scale)
     never uncover the frame's edges. Both live on custom properties, not
     the transform property itself, so the two effects compose instead of
     one overwriting the other's inline style. */
  .industry__media img {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    transform: translateY(var(--parallax-y, 0px)) scale(var(--hover-scale, 1));
    transition: transform 0.5s ease;
  }

  .industry__media:hover img {
    --hover-scale: 1.04;
  }

  @media (prefers-reduced-motion: reduce) {
    .industry__media img {
      transition: none;
    }
  }

  .industry__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .industry__intro {
    font-size: 1.625rem;
    line-height: 1.5;
    font-weight: 600;
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .industry__split {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
