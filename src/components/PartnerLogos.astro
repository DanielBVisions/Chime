---
// Real logos where we have them (public/images/partner-logos/); plain text
// wordmarks for partners without an asset yet. role-ticker.ts progressively
// enhances this into a single-track infinite marquee (tech spec §5.7),
// skipped under prefers-reduced-motion.
const partners = [
  { name: 'UK Power Networks', logo: '/images/partner-logos/uk-power-networks.avif' },
  { name: 'SSE', logo: '/images/partner-logos/sse.svg' },
  { name: 'Cadent Gas' },
  { name: 'ESB Networks', logo: '/images/partner-logos/esb-networks.png' },
  { name: 'NRE Services Ltd' },
  { name: 'TreeSmiths' },
  { name: 'Oakwick' },
  { name: 'SP Energy', logo: '/images/partner-logos/sp-energy.png' },
  { name: 'Electricity North West', logo: '/images/partner-logos/electricity-north-west.avif' },
];
---

<section class="section partners">
  <div class="container" data-reveal>
    <p class="partners__label">Partnered with</p>

    <div class="partners__marquee" data-partner-logos>
      <div class="partners__group" data-partner-group>
        <ul class="partners__list" data-partner-track>
          {partners.map((partner) => (
            <li>
              {partner.logo ? (
                <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
              ) : (
                partner.name
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .partners__label {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-600);
  }

  .partners__marquee {
    overflow: hidden;
    margin-top: var(--space-gutter);
  }

  .partners__group {
    display: flex;
  }

  .partners__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 3rem;
    width: 100%;
  }

  .partners__list li {
    display: flex;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-grey-600);
    filter: grayscale(1);
    white-space: nowrap;
    transition: color 0.2s ease, filter 0.2s ease, opacity 0.2s ease;
  }

  .partners__list li img {
    height: 2rem;
    width: auto;
    max-width: 9rem;
    opacity: 0.7;
  }

  .partners__list li:hover {
    color: var(--color-blue-deep);
    filter: grayscale(0);
  }

  .partners__list li:hover img {
    opacity: 1;
  }

  /* Marquee state — added by role-ticker.ts once it clones the track;
     never applied under prefers-reduced-motion, so the wrapped list
     above is the reduced-motion fallback by construction. */
  .partners__marquee.is-marquee .partners__group {
    width: max-content;
  }

  .partners__marquee.is-marquee .partners__list {
    flex-wrap: nowrap;
    justify-content: flex-start;
    flex-shrink: 0;
    width: max-content;
    padding-inline-end: 3rem;
  }
</style>
