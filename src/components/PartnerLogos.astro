---
// Only partners we have a real logo asset for (public/images/partner-logos/)
// - no text-placeholder entries. role-ticker.ts progressively enhances this
// into a single-track infinite marquee (tech spec §5.7), skipped under
// prefers-reduced-motion.
const partners = [
  { name: 'UK Power Networks', logo: '/images/partner-logos/uk-power-networks.avif' },
  { name: 'SSE', logo: '/images/partner-logos/sse.svg' },
  { name: 'ESB Networks', logo: '/images/partner-logos/esb-networks.png' },
  { name: 'SP Energy', logo: '/images/partner-logos/sp-energy.png' },
  { name: 'Electricity North West', logo: '/images/partner-logos/electricity-north-west.avif' },
];
---

<section class="section partners">
  <div class="container" data-reveal>
    <p class="partners__label">Partnered with</p>

    <div class="partners__marquee" data-partner-logos>
      <div class="partners__group" data-partner-group>
        <ul class="partners__list" data-partner-track>
          {partners.map((partner) => (
            <li>
              <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .partners__label {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-600);
  }

  .partners__marquee {
    overflow: hidden;
    margin-top: var(--space-gutter);
  }

  .partners__group {
    display: flex;
  }

  .partners__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 3rem;
    width: 100%;
  }

  .partners__list li {
    display: flex;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-grey-600);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  /* Full colour, fixed footprint (width AND height, not just height) so
     every logo occupies the same box regardless of its own aspect ratio -
     same treatment as the hero trust strip. Grayscale-until-hover was
     washing these out enough to read as still-unstyled placeholders. */
  .partners__list li img {
    width: 7rem;
    height: 2.25rem;
    object-fit: contain;
  }

  .partners__list li:hover {
    color: var(--color-blue-deep);
  }

  /* Marquee state — added by role-ticker.ts once it clones the track;
     never applied under prefers-reduced-motion, so the wrapped list
     above is the reduced-motion fallback by construction. */
  .partners__marquee.is-marquee .partners__group {
    width: max-content;
  }

  .partners__marquee.is-marquee .partners__list {
    flex-wrap: nowrap;
    justify-content: flex-start;
    flex-shrink: 0;
    width: max-content;
    padding-inline-end: 3rem;
  }
</style>
