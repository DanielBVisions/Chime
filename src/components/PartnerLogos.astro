---
// Rendered as text wordmarks for now — swap each span for an <img> once real
// partner SVGs land in public/images/partner-logos/ (tech spec §8, item 5-adjacent).
// role-ticker.ts progressively enhances this into a single-track infinite
// marquee (tech spec §5.7), skipped under prefers-reduced-motion.
const partners = [
  'UK Power Networks',
  'SSE',
  'Cadent Gas',
  'ESB Networks',
  'NRE Services Ltd',
  'TreeSmiths',
  'Oakwick',
  'SP Electricity North West',
];
---

<section class="section partners">
  <div class="container" data-reveal>
    <p class="partners__label">Partnered with</p>

    <div class="partners__marquee" data-partner-logos>
      <div class="partners__group" data-partner-group>
        <ul class="partners__list" data-partner-track>
          {partners.map((partner) => (
            <li>{partner}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .partners__label {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-grey-600);
  }

  .partners__marquee {
    overflow: hidden;
    margin-top: var(--space-gutter);
  }

  .partners__group {
    display: flex;
  }

  .partners__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 3rem;
    width: 100%;
  }

  .partners__list li {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-grey-600);
    filter: grayscale(1);
    white-space: nowrap;
    transition: color 0.2s ease, filter 0.2s ease;
  }

  .partners__list li:hover {
    color: var(--color-blue-deep);
    filter: grayscale(0);
  }

  /* Marquee state — added by role-ticker.ts once it clones the track;
     never applied under prefers-reduced-motion, so the wrapped list
     above is the reduced-motion fallback by construction. */
  .partners__marquee.is-marquee .partners__group {
    width: max-content;
  }

  .partners__marquee.is-marquee .partners__list {
    flex-wrap: nowrap;
    justify-content: flex-start;
    flex-shrink: 0;
    width: max-content;
    padding-inline-end: 3rem;
  }
</style>
