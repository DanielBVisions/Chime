---
const testimonials = [
  {
    quote:
      "CHIME let us train contractors quickly, deploy them using their own devices, and verify every job was done on-site – all while delivering the program ahead of schedule and under budget.",
    name: 'Andy Horstead',
    title: 'Senior Asset Engineer, UK Power Networks',
  },
  {
    quote: 'CHIME is going to be everywhere, there is nothing like it.',
    name: 'Andrew Roper',
    title: 'Director, SSE Networks',
  },
  {
    quote:
      'CHiME Locate has transformed how we manage faults. It enables us to dispatch the right teams quickly to faults and inspections, improving response times and keeping operations efficient.',
    name: 'Paul Rawlinson',
    title: 'HV Control Manager, SP Electricity North West',
  },
  {
    quote:
      "Can't believe we have done two completely different processes in a trial and no programming needed.",
    name: 'Chris Rison',
    title: 'Head of Smart Network, Cadent Gas',
  },
  {
    quote:
      'We chose CHIME based on the brilliant feedback from our operational staff who were able to see how the solution could make their jobs easier, and the flexibility of the product to adapt as we identify continuous improvement ideas in our business.',
    name: 'Suleman Alli',
    title: 'Director, UK Power Networks',
  },
  {
    quote:
      'We needed a one-stop solution as our work intensifies and we prepare for a net zero future. The richness of CHIME functionality gives us a package that is better for us and cheaper for customers. CHIME simply fits our industry and goes from strength to strength.',
    name: 'David Brocksom',
    title: 'Ex-CFO, SP Electricity North West',
  },
];
---

<section class="section testimonials">
  <div class="container">
    <h2 data-reveal-heading>What our Customers Say</h2>

    <div class="testimonials__carousel" data-reveal>
      <button type="button" class="testimonials__arrow" data-testimonial-prev aria-label="Previous testimonials">
        &larr;
      </button>

      <div
        class="testimonials__viewport"
        data-testimonial-viewport
        role="group"
        aria-roledescription="carousel"
        aria-label="Customer testimonials"
        tabindex="0"
      >
        <ul class="testimonials__track" data-testimonial-track>
          {testimonials.map((testimonial) => (
            <li class="testimonials__slide" data-testimonial-label={`${testimonial.name}, ${testimonial.title}`}>
              <div class="testimonials__card">
                <blockquote>
                  <p>"{testimonial.quote}"</p>
                  <footer>
                    <cite>{testimonial.name}</cite>, {testimonial.title}
                  </footer>
                </blockquote>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <button type="button" class="testimonials__arrow" data-testimonial-next aria-label="Next testimonials">
        &rarr;
      </button>
    </div>

    <div class="testimonials__dots" data-testimonial-dots></div>

    <p class="visually-hidden" role="status" aria-live="polite" data-testimonial-live></p>
  </div>
</section>

<style>
  .testimonials h2 {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .testimonials__carousel {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* padding-block gives the active card's own box-shadow (0 24px 40px
     -16px, offset downward) room to render - it extends past the card's
     own layout box, so with no buffer here it was getting clipped by
     this element's overflow:hidden at the bottom. */
  .testimonials__viewport {
    flex: 1;
    min-width: 0;
    padding-block: 3rem;
    overflow: hidden;
  }

  .testimonials__viewport:focus-visible {
    outline: 2px solid var(--color-blue-mid);
    outline-offset: 4px;
  }

  .testimonials__track {
    display: flex;
    align-items: center;
  }

  /* Centre-focused carousel: every slide is the same flex-basis (so the
     track's offset math stays simple). The active card renders at its
     true, unscaled size (1) - full opacity, no transform - while its
     neighbours and everything beyond scale DOWN instead of the active
     card scaling UP. Scaling up was what caused the clipping: transform
     doesn't change an element's layout footprint, so a scaled-up card
     painted taller than the row's own layout height and got cut off by
     the viewport's overflow:hidden. Nothing here ever paints larger
     than its own box, so that can't happen. */
  .testimonials__slide {
    flex: 0 0 80%;
    max-width: 80%;
    box-sizing: border-box;
    padding-inline: 1.5rem;
  }

  @media (min-width: 640px) {
    .testimonials__slide {
      flex-basis: 48%;
      max-width: 48%;
    }
  }

  @media (min-width: 1024px) {
    .testimonials__slide {
      flex-basis: 36%;
      max-width: 36%;
    }
  }

  /* Fixed height (not content-driven) so every card shares the same base
     size before the scale transform below is applied - otherwise a short
     quote and a long quote produce differently-sized boxes regardless of
     tier, instead of "active tallest, its two neighbours equal to each
     other". Tall enough to fit the longest quote in full at this font
     size/card width without clamping it mid-sentence - the line-clamp
     below is a safety net for anything longer still, not the primary
     mechanism. */
  .testimonials__card {
    height: 19rem;
    display: flex;
    padding: 1.75rem;
    background: var(--color-grey-100);
    border-radius: 18px;
    box-sizing: border-box;
    overflow: hidden;
    transform: scale(0.78);
    opacity: 0.35;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease, box-shadow 0.3s ease;
  }

  /* flex-shrink: 0 is load-bearing, not decorative - .testimonials__card
     is itself display:flex (row), and blockquote is its only child. Even
     though blockquote's own width:100% exactly matches the card's
     available content width, the default flex-shrink:1 still shrinks it
     well below that (confirmed independently: ~360px collapsed to
     ~280px in an isolated reproduction) - the flex algorithm's basis
     calculation for blockquote picks up on its own nested content's
     intrinsic sizing rather than simply honouring the 100% width. That
     shrink is what was actually causing the severe word-wrapping inside
     every card, at any viewport width, not the card/slide width itself
     (which was already computing correctly). */
  .testimonials__card blockquote {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    justify-content: space-between;
    height: 100%;
    width: 100%;
  }

  .testimonials__slide.is-adjacent .testimonials__card {
    transform: scale(0.88);
    opacity: 0.65;
  }

  .testimonials__slide.is-active .testimonials__card {
    position: relative;
    z-index: 1;
    transform: scale(1);
    opacity: 1;
    box-shadow: 0 24px 40px -16px rgba(11, 92, 173, 0.22);
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials__card {
      transition: opacity 0.4s ease;
    }
  }

  .testimonials__card p {
    font-size: 0.9375rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    overflow: hidden;
  }

  .testimonials__card footer {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-grey-600);
  }

  .testimonials__card cite {
    font-style: normal;
    font-weight: 700;
    color: var(--color-ink);
  }

  .testimonials__arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-grey-100);
    font-size: 1.1rem;
  }

  /* Below 640px (where slides are 80% of the viewport, not a fixed
     tier), the two 44px arrow buttons plus their gaps were eating a
     large share of a narrow screen's width before the viewport even
     got sized - on a ~390px phone that left barely 170px for each
     card, cramming the quote text down to 2-3 words per line. There's
     no swipe/touch navigation (checked testimonial-carousel.ts - only
     a touchstart listener that pauses autoplay), so the arrows can't
     just be hidden; overlaying them on top of the viewport instead of
     sitting beside it in the flex row lets the viewport use the full
     width.

     This has to come AFTER the base .testimonials__arrow rule above -
     both selectors have identical specificity, and a matched @media
     block doesn't add any, so with equal specificity the cascade falls
     back to source order. Placed before that base rule (as it originally
     was), the base rule's later width/height/background silently won on
     every viewport, undoing this block's 36px/white overrides while its
     position/transform/z-index (untouched by the base rule) still took
     effect - the arrows were absolutely positioned but never actually
     resized or recoloured. */
  @media (max-width: 640px) {
    .testimonials h2 {
      font-size: 1.875rem;
    }

    .testimonials__carousel {
      position: relative;
    }

    .testimonials__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 36px;
      height: 36px;
      background: var(--color-white);
      box-shadow: 0 4px 12px rgba(20, 24, 29, 0.15);
    }

    .testimonials__arrow[data-testimonial-prev] {
      left: 0.25rem;
    }

    .testimonials__arrow[data-testimonial-next] {
      right: 0.25rem;
    }
  }

  .testimonials__dots {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }

  .testimonials__dots :global(.testimonials__dot) {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-grey-600);
    padding: 0;
    transition: width 0.2s ease, background-color 0.2s ease;
  }

  .testimonials__dots :global(.testimonials__dot.is-active) {
    width: 22px;
    background: var(--color-blue-deep);
  }
</style>
