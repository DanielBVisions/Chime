---
interface Props {
  title: string;
  body: string;
  icon: string;
  rotation?: number;
}

const { title, body, icon, rotation = 0 } = Astro.props;
---

<article class="feature-card" data-reveal style={`--card-rotation: ${rotation}deg`}>
  <span class="feature-card__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" set:html={icon} />
  </span>
  <h3>{title}</h3>
  <p>{body}</p>
</article>

<style>
  .feature-card {
    background: var(--color-white);
    border: 1px solid var(--color-grey-100);
    border-radius: 18px;
    padding: 1.625rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 8px 20px -6px rgba(20, 24, 29, 0.08);
    transform: rotate(var(--card-rotation));
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .feature-card:hover {
    transform: rotate(var(--card-rotation)) translateY(-6px) scale(1.03);
    box-shadow: 0 20px 32px -12px rgba(11, 92, 173, 0.25);
  }

  .feature-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.875rem;
    height: 2.875rem;
    border-radius: 0.8125rem;
    background: var(--gradient-signal);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .feature-card:hover .feature-card__icon {
    transform: scale(1.15) rotate(-8deg);
  }

  .feature-card__icon svg {
    width: 1.3125rem;
    height: 1.3125rem;
  }

  .feature-card h3 {
    font-size: 1rem;
    font-weight: 700;
  }

  .feature-card p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-grey-600);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card,
    .feature-card__icon {
      transition: none;
    }
  }
</style>
