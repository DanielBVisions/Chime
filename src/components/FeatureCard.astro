---
interface Props {
  title: string;
  body: string;
  icon: string;
}

const { title, body, icon } = Astro.props;
---

<article class="feature-card" data-reveal>
  <span class="feature-card__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" set:html={icon} />
  </span>
  <h3>{title}</h3>
  <p>{body}</p>
</article>

<style>
  .feature-card {
    background: var(--color-white);
    border: 1px solid var(--color-grey-100);
    border-radius: 18px;
    padding: var(--space-gutter);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 8px 20px -6px rgba(20, 24, 29, 0.08);
  }

  .feature-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--gradient-signal);
  }

  .feature-card__icon svg {
    width: 22px;
    height: 22px;
  }

  .feature-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .feature-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-grey-600);
  }
</style>
