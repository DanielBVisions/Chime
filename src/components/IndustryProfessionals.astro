---
import RoleTicker from './RoleTicker.astro';
import BrandArc from './BrandArc.astro';
---

<section class="professionals">
  <div class="professionals__ticker-band">
    <BrandArc size={480} anchor="bottom-left" variant="white" style="bottom: -140px; left: -140px;" />
    <RoleTicker />
  </div>

  <div class="container professionals__clear-horizon" data-reveal>
    <div class="professionals__clear-horizon-card">
      <span class="professionals__clear-horizon-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
          <circle cx="12" cy="8" r="2.25" fill="#fff" stroke="none" />
          <path d="M3 17 C6 13 9.5 11 12 11 C14.5 11 18 13 21 17" />
        </svg>
      </span>
      <div class="professionals__clear-horizon-copy">
        <h3>Clear Horizon</h3>
        <p>
          Our team specialises in the business of regulated network operators. We have consultants
          with over 20 years industry experience combined with highly skilled business analysts,
          solution design and secure enterprise IT service architecture. Our reputation at the most
          senior levels in the industry is built on the strength of our exceptional team.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .professionals {
    background: var(--color-white);
  }

  .professionals__ticker-band {
    position: relative;
    background: linear-gradient(120deg, var(--color-blue-deep), var(--color-blue-mid) 130%);
    padding-block: 2.5rem;
    overflow: hidden;
  }

  .professionals__clear-horizon {
    padding-block: var(--space-section);
  }

  /* Bounded, tinted card instead of a label + paragraph floating loose
     in the full-width container - gives the block visual presence and
     keeps the copy at a readable measure instead of stretching edge to
     edge of the page's wide container. */
  .professionals__clear-horizon-card {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: 3rem;
    background: var(--color-grey-100);
    border-radius: 1.5rem;
  }

  .professionals__clear-horizon-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.9375rem;
    background: var(--gradient-signal);
  }

  .professionals__clear-horizon-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .professionals__clear-horizon-copy h3 {
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .professionals__clear-horizon-copy p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-grey-600);
  }

  @media (max-width: 700px) {
    .professionals__clear-horizon-card {
      flex-direction: column;
      padding: 2rem;
    }
  }
</style>
