---
---

<section class="enquire" id="contact">
  <div class="container">
    <div class="enquire__card" data-reveal>
      <div class="enquire__top">
        <h2 data-reveal-heading>Ready to transform your field operations?</h2>
        <p class="enquire__sub">
          Schedule a demo today and see how CHiME can transform field force productivity for your
          network operations.
        </p>
      </div>

      <form class="enquire__bar" data-enquire-form novalidate>
        <div class="enquire__field">
          <label for="name" class="visually-hidden">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="Full Name" required />
        </div>

        <div class="enquire__field">
          <label for="email" class="visually-hidden">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="Your Email" required />
        </div>

        <button type="submit" class="enquire__submit" aria-label="Submit enquiry">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </form>
    </div>

    <p class="enquire__status" data-enquire-status role="status" aria-live="polite" hidden></p>
  </div>
</section>

<style>
  .enquire {
    padding-block: var(--space-section);
  }

  /* Two-tier card - gradient "headline" top half, full-bleed dark bar
     along the bottom holding the actual form - rather than everything
     sitting on one flat background at the same visual weight. Uses the
     same blue gradient already established for AcceleratingProductivity
     and ChimeAdvantage: the reference's bright-cyan/black pairing was a
     layout cue, not a colour one. */
  .enquire__card {
    border-radius: 2.5rem;
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-blue-deep), var(--color-blue-mid) 130%);
  }

  .enquire__top {
    padding: 3.5rem 3rem 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .enquire h2 {
    max-width: 26rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-white);
  }

  .enquire__sub {
    max-width: 22rem;
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .enquire__bar {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    background: var(--color-ink);
    padding: 1.5rem 2rem;
  }

  .enquire__field {
    flex: 1;
    min-width: 8rem;
    display: flex;
    align-items: center;
  }

  .enquire__field input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-block: 0.625rem;
    color: var(--color-white);
    font: inherit;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .enquire__field input::placeholder {
    color: rgba(255, 255, 255, 0.45);
    font-weight: 700;
  }

  .enquire__field input:focus-visible {
    outline: none;
    border-bottom-color: var(--color-blue-pale);
  }

  .enquire__submit {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    align-self: center;
    border-radius: 999px;
    background: var(--color-blue-pale);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s var(--ease-out-expo), transform 0.2s var(--ease-out-expo);
  }

  .enquire__submit:hover,
  .enquire__submit:focus-visible {
    background: var(--color-white);
    transform: translateX(3px);
  }

  .enquire__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .enquire__status {
    margin-top: 1rem;
    text-align: center;
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .enquire__top {
      padding: 2.5rem 1.75rem 2rem;
    }

    .enquire__bar {
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem;
    }

    .enquire__submit {
      align-self: flex-end;
    }
  }
</style>
