---
import BrandArc from './BrandArc.astro';
---

<section class="enquire" id="contact">
  <div class="enquire__glow" aria-hidden="true"></div>
  <BrandArc size={460} anchor="top-right" variant="white" style="bottom: -140px; right: -100px;" />

  <div class="container enquire__inner" data-reveal>
    <h2 data-reveal-heading>Enquire Now For a Demo</h2>
    <p class="enquire__sub">Transform your field operations with our innovative solutions designed for network operators.</p>

    <form class="enquire__form" data-enquire-form novalidate>
      <div class="enquire__field">
        <label for="name" class="visually-hidden">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" placeholder="Full Name" required />
      </div>

      <div class="enquire__field">
        <label for="email" class="visually-hidden">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" placeholder="Your Email" required />
      </div>

      <button type="submit" class="btn enquire__submit">Enquire Now</button>
    </form>

    <p class="enquire__status" data-enquire-status role="status" aria-live="polite" hidden></p>
  </div>
</section>

<style>
  .enquire {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #050b14, var(--color-blue-deep) 55%, #081522);
    color: var(--color-white);
  }

  /* Soft radial glow behind the form for depth, echoing the moody/lit
     look of the reference rather than a flat gradient. */
  .enquire__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(60% 60% at 50% 40%, rgba(63, 169, 218, 0.28), transparent 70%);
  }

  .enquire__inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding-block: 7rem;
  }

  .enquire h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .enquire__sub {
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
  }

  .enquire__form {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }

  .enquire__field {
    flex: 1 1 13rem;
    min-width: 12rem;
  }

  .enquire__field input {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 0.875rem 1.125rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    font: inherit;
  }

  .enquire__field input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .enquire__field input:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  /* Warm accent against the dark, cool background — deliberately a
     different colour from the site's blue CTAs elsewhere, for contrast
     on a section that's meant to read as the conversion moment. */
  .enquire__submit {
    flex-shrink: 0;
    background: #f0a93a;
    color: #241000;
  }

  .enquire__submit:hover,
  .enquire__submit:focus-visible {
    background: #f7bd5f;
  }

  .enquire__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .enquire__status {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .enquire__form {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
