---
import BrandArc from './BrandArc.astro';
---

<section class="enquire" id="contact">
  <BrandArc size={460} anchor="top-right" variant="white" style="bottom: -140px; right: -100px;" />

  <div class="container enquire__inner" data-reveal>
    <div class="enquire__copy">
      <h2 data-reveal-heading>Enquire Now For a Demo</h2>
      <p>Transform your field operations with our innovative solutions designed for network operators.</p>
    </div>

    <form class="enquire__form" data-enquire-form novalidate>
      <div class="enquire__field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" required />
      </div>

      <div class="enquire__field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>

      <button type="submit" class="btn">Submit</button>

      <p class="enquire__status" data-enquire-status role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<style>
  .enquire {
    position: relative;
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-blue-deep), var(--color-blue-mid) 130%);
    color: var(--color-white);
  }

  /* Darkening scrim so white text/inputs stay WCAG-AA legible wherever they
     land on the gradient — the lighter end alone (blue-mid) only gives
     white text ~2.7:1 contrast, well under the 4.5:1 normal-text minimum. */
  .enquire::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(0, 0, 0, 0.35);
  }

  .enquire__inner {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 4.5rem;
    align-items: flex-start;
    padding-block: 6rem;
  }

  .enquire__copy {
    flex: 0 0 28.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .enquire h2 {
    font-size: 2.25rem;
    font-weight: 800;
  }

  .enquire__copy p {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .enquire__form {
    flex: 1;
    max-width: 30rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .enquire__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .enquire__field label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
  }

  .enquire__field input,
  .enquire__field textarea {
    padding: 0.8125rem 1rem;
    border-radius: 10px;
    border: none;
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-ink);
    font: inherit;
  }

  .enquire__field input:focus-visible,
  .enquire__field textarea:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  .enquire__form .btn {
    align-self: flex-start;
    background: var(--color-white);
    color: var(--color-blue-deep);
  }

  .enquire__form .btn:hover,
  .enquire__form .btn:focus-visible {
    background: var(--color-blue-pale);
  }

  .enquire__form .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .enquire__status {
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .enquire__inner {
      flex-direction: column;
    }

    .enquire__form {
      max-width: none;
      width: 100%;
    }
  }
</style>
