---
---

<section class="enquire" id="contact">
  <div class="container">
    <div class="enquire__card" data-reveal>
      <div class="enquire__top">
        <h2 data-reveal-heading>Ready to transform your field operations?</h2>
        <p class="enquire__sub">
          Schedule a demo today and see how CHiME can transform field force productivity for your
          network operations.
        </p>
      </div>

      <form class="enquire__bar" data-enquire-form novalidate>
        <div class="enquire__field">
          <label for="name" class="visually-hidden">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="Full Name" required />
        </div>

        <div class="enquire__field">
          <label for="email" class="visually-hidden">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="Your Email" required />
        </div>

        <button type="submit" class="btn enquire__submit">Submit</button>
      </form>
    </div>

    <p class="enquire__status" data-enquire-status role="status" aria-live="polite" hidden></p>
  </div>
</section>

<style>
  .enquire {
    padding-block: var(--space-section);
  }

  /* Two-tier card - gradient "headline" top half, full-bleed dark bar
     along the bottom holding the actual form - rather than everything
     sitting on one flat background at the same visual weight. Uses the
     same blue gradient already established for AcceleratingProductivity
     and ChimeAdvantage: the reference's bright-cyan/black pairing was a
     layout cue, not a colour one. */
  .enquire__card {
    max-width: 64rem;
    margin-inline: auto;
    border-radius: 2.5rem;
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-blue-deep), var(--color-blue-mid) 130%);
  }

  .enquire__top {
    padding: 3.5rem 3rem 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.5rem;
  }

  /* Matches ChimeAdvantage's h2 exactly (2.75rem/800) rather than its
     own clamp - this site's other section headings all use one of a
     couple of fixed sizes, not a range that can render larger than any
     of them depending on viewport width. */
  .enquire h2 {
    max-width: 26rem;
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-white);
  }

  .enquire__sub {
    max-width: 22rem;
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Dark brand blue, not black - the reference's black bar was a layout
     cue (a visibly separate, darker tier under the headline), not a
     colour to copy outright. */
  .enquire__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--color-blue-deep);
    padding: 1.125rem 1.5rem;
  }

  .enquire__field {
    flex: 1;
    min-width: 8rem;
  }

  /* Filled pill inputs, not bare text on a hairline underline - the
     underline treatment left the bar looking mostly empty/undefined;
     these actually read as input fields sitting in the bar. Sized to
     match .btn's own scale (global.css), not larger. */
  .enquire__field input {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 0.625rem 1.125rem;
    color: var(--color-white);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .enquire__field input::placeholder {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
  }

  .enquire__field input:focus-visible {
    outline: none;
    border-color: var(--color-blue-pale);
    background: rgba(255, 255, 255, 0.14);
  }

  /* Uses the shared .btn sizing (global.css) like every other button on
     the site, instead of its own larger custom padding/font-size - only
     the colour is section-specific. */
  .enquire__submit {
    flex-shrink: 0;
    background: var(--color-blue-pale);
    color: var(--color-ink);
  }

  .enquire__submit:hover,
  .enquire__submit:focus-visible {
    background: var(--color-white);
  }

  .enquire__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .enquire__status {
    margin-top: 1rem;
    text-align: center;
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    .enquire__top {
      padding: 2.5rem 1.75rem 2rem;
    }

    .enquire__bar {
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem;
    }

    .enquire__submit {
      align-self: flex-end;
    }
  }
</style>
