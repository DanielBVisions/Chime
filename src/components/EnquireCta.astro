---
---

<section class="section enquire" id="contact">
  <div class="container enquire__inner" data-reveal>
    <h2>Enquire Now For a Demo</h2>
    <p>Transform your field operations with our innovative solutions designed for network operators.</p>

    <form class="enquire__form" data-enquire-form novalidate>
      <div class="enquire__field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" required />
      </div>

      <div class="enquire__field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>

      <div class="enquire__field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit" class="btn">Submit</button>

      <p class="enquire__status" data-enquire-status role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<style>
  .enquire {
    background: var(--color-blue-deep);
    color: var(--color-white);
  }

  .enquire__inner {
    max-width: 40rem;
  }

  .enquire h2 {
    font-size: var(--fs-h2);
    font-weight: 700;
    text-transform: uppercase;
  }

  .enquire > .container > p {
    margin-top: 1rem;
    font-size: 1.1rem;
  }

  .enquire__form {
    margin-top: var(--space-gutter);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .enquire__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .enquire__field label {
    font-size: 0.9rem;
    font-weight: 700;
  }

  .enquire__field input,
  .enquire__field textarea {
    padding: 0.85rem 1rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-white);
    font: inherit;
  }

  .enquire__field input:focus-visible,
  .enquire__field textarea:focus-visible {
    outline: 2px solid var(--color-blue-pale);
    outline-offset: 2px;
  }

  .enquire__form .btn {
    align-self: flex-start;
    background: var(--color-white);
    color: var(--color-blue-deep);
  }

  .enquire__form .btn:hover,
  .enquire__form .btn:focus-visible {
    background: var(--color-blue-pale);
  }

  .enquire__status {
    font-weight: 700;
  }
</style>
