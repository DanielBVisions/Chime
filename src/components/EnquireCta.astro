---
import BrandArc from './BrandArc.astro';
---

<section class="enquire" id="contact">
  <div class="enquire__backdrop" aria-hidden="true"></div>
  <BrandArc size={720} anchor="top-right" variant="white" style="top: -220px; right: -220px; opacity: 0.5;" />
  <BrandArc size={560} anchor="bottom-left" variant="white" style="bottom: -180px; left: -180px; opacity: 0.35;" />

  <div class="container enquire__inner">
    <div class="enquire__panel" data-reveal>
      <span class="eyebrow enquire__eyebrow">Get Started</span>
      <h2 data-reveal-heading>
        Enquire Now <span class="enquire__accent">For a Demo</span>
      </h2>
      <p class="enquire__sub">Transform your field operations with our innovative solutions designed for network operators.</p>

      <form class="enquire__form" data-enquire-form novalidate>
        <div class="enquire__field">
          <label for="name" class="visually-hidden">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="Full Name" required />
        </div>

        <div class="enquire__field">
          <label for="email" class="visually-hidden">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="Your Email" required />
        </div>

        <button type="submit" class="btn enquire__submit">Enquire Now</button>
      </form>

      <p class="enquire__status" data-enquire-status role="status" aria-live="polite" hidden></p>
    </div>
  </div>
</section>

<style>
  /* Genuinely different from a re-themed version of the old flat
     gradient band: a layered, textured backdrop with a floating glass
     panel on top, rather than text+form sitting directly on a solid
     background. */
  .enquire {
    position: relative;
    overflow: hidden;
    background: #04070d;
    color: var(--color-white);
    padding-block: 6rem;
  }

  .enquire__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(45% 60% at 18% 15%, rgba(63, 169, 218, 0.35), transparent 70%),
      radial-gradient(55% 65% at 85% 90%, rgba(240, 169, 58, 0.16), transparent 70%),
      radial-gradient(80% 80% at 50% 50%, var(--color-blue-deep), #04070d 75%);
  }

  .enquire__inner {
    position: relative;
    z-index: 1;
  }

  /* The floating "glass" card - the actual structural difference from
     the old design, which had copy/form sitting flush on the section's
     own background with nothing separating them from it. */
  .enquire__panel {
    max-width: 46rem;
    margin-inline: auto;
    padding: 3.5rem 3rem;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .enquire__eyebrow {
    color: #f0a93a;
  }

  .enquire h2 {
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .enquire__accent {
    color: var(--color-blue-pale);
  }

  .enquire__sub {
    max-width: 32rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .enquire__form {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }

  .enquire__field {
    flex: 1 1 13rem;
    min-width: 12rem;
  }

  .enquire__field input {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 0.875rem 1.125rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    font: inherit;
  }

  .enquire__field input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .enquire__field input:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  /* Warm accent against the dark, cool backdrop — deliberately a
     different colour from the site's blue CTAs elsewhere, since this
     section is meant to read as the conversion moment. */
  .enquire__submit {
    flex-shrink: 0;
    background: #f0a93a;
    color: #241000;
  }

  .enquire__submit:hover,
  .enquire__submit:focus-visible {
    background: #f7bd5f;
  }

  .enquire__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .enquire__status {
    margin-top: 0.75rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .enquire__panel {
      padding: 2.5rem 1.75rem;
    }

    .enquire__form {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
