---
// Deduped canonical role list. Renders as a static wrapped list by default;
// role-ticker.ts progressively enhances it into a two-track infinite marquee
// (tech spec §5.4), skipped entirely under prefers-reduced-motion.
const roles = [
  'Fault engineers',
  'network designers',
  'construction engineers',
  'team leaders',
  'job planners',
  'safety officers',
  'security architects',
  'project managers',
  'transformation directors',
  'service delivery teams',
  'cable layers',
  'tree cutters',
  'surveyors',
  'process designers',
  'project controllers',
  'regulatory accountants',
  'contractors',
  'civils work teams',
  'job estimators',
];
---

<div class="role-ticker" data-role-ticker data-reveal>
  <div class="role-ticker__group" data-role-ticker-group>
    <ul class="role-ticker__list" data-role-ticker-track>
      {roles.map((role) => (
        <li>{role}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .role-ticker {
    overflow: hidden;
    padding-block: 1.5rem;
    border-block: 1px solid rgba(255, 255, 255, 0.2);
  }

  .role-ticker__group {
    display: flex;
  }

  .role-ticker__list {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.75rem;
    justify-content: center;
    width: 100%;
  }

  .role-ticker__list li {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-white);
    white-space: nowrap;
  }

  .role-ticker__list li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.75rem;
    color: var(--color-blue-mid);
  }

  /* Marquee state — added by role-ticker.ts once it clones the track;
     never applied under prefers-reduced-motion, so the static wrapped
     list above is the reduced-motion fallback by construction. */
  .role-ticker.is-marquee .role-ticker__group {
    width: max-content;
  }

  .role-ticker.is-marquee .role-ticker__list {
    flex-wrap: nowrap;
    justify-content: flex-start;
    flex-shrink: 0;
    width: max-content;
    padding-inline-end: 3rem;
  }
</style>
