---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CHiME — built for the network operator.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot />

    <script>
      import { initSmoothScroll } from '../scripts/smooth-scroll';
      import { initRevealAnimations } from '../scripts/reveal-animations';
      import { initRoleTicker, initPartnerMarquee } from '../scripts/role-ticker';
      import { initTestimonialCarousel } from '../scripts/testimonial-carousel';
      import { initHero } from '../scripts/hero';
      import { initNav } from '../scripts/nav';
      import { initContactForm } from '../scripts/contact-form';
      import { initChimeAdvantage } from '../scripts/chime-advantage';
      import { initHeadingReveal } from '../scripts/heading-reveal';
      import { initImageParallax } from '../scripts/image-parallax';
      import { initDeliversTimeline } from '../scripts/delivers-timeline';

      initSmoothScroll();
      initRevealAnimations();
      initRoleTicker();
      initPartnerMarquee();
      initTestimonialCarousel();
      initHero();
      initNav();
      initContactForm();
      initChimeAdvantage();
      initHeadingReveal();
      initImageParallax();
      initDeliversTimeline();
    </script>
  </body>
</html>
