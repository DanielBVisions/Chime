---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CHiME — built for the network operator.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <slot />

    <script>
      import { initSmoothScroll } from '../scripts/smooth-scroll';
      import { initRevealAnimations } from '../scripts/reveal-animations';
      import { initRoleTicker, initPartnerMarquee, initHeroTrustMarquee } from '../scripts/role-ticker';
      import { initTestimonialCarousel } from '../scripts/testimonial-carousel';
      import { initHero } from '../scripts/hero';
      import { initNav } from '../scripts/nav';
      import { initContactForm } from '../scripts/contact-form';
      import { initChimeAdvantage } from '../scripts/chime-advantage';
      import { initHeadingReveal } from '../scripts/heading-reveal';
      import { initImageParallax } from '../scripts/image-parallax';
      import { initDeliversTimeline } from '../scripts/delivers-timeline';
      import { initIndustryCrossfade } from '../scripts/industry-crossfade';

      // Each init runs independently - these all live in one synchronous
      // script block, so an uncaught error thrown by any one of them
      // would otherwise stop every init call scheduled after it from
      // ever running at all, on that page load. A bug confined to (say)
      // the partner-logo marquee has no business silently taking the
      // testimonial carousel or the CHiME Advantage scroll down with it.
      const inits: [string, () => void][] = [
        ['initSmoothScroll', initSmoothScroll],
        ['initRevealAnimations', initRevealAnimations],
        ['initRoleTicker', initRoleTicker],
        ['initPartnerMarquee', initPartnerMarquee],
        ['initHeroTrustMarquee', initHeroTrustMarquee],
        ['initTestimonialCarousel', initTestimonialCarousel],
        ['initHero', initHero],
        ['initNav', initNav],
        ['initContactForm', initContactForm],
        ['initChimeAdvantage', initChimeAdvantage],
        ['initHeadingReveal', initHeadingReveal],
        ['initImageParallax', initImageParallax],
        ['initDeliversTimeline', initDeliversTimeline],
        ['initIndustryCrossfade', initIndustryCrossfade],
      ];

      for (const [name, fn] of inits) {
        try {
          fn();
        } catch (error) {
          console.error(`[init] ${name} failed:`, error);
        }
      }
    </script>
  </body>
</html>
